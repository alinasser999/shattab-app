SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Local debug shortcut only. Keep disabled and blank outside local development.
DEBUG_AUTH_ENABLED=false
DEBUG_AUTH_EMAIL=
DEBUG_AUTH_PASSWORD=

# Optional. Leave blank to run without crash reporting.
# Create a Flutter project at sentry.io and paste its DSN here.
SENTRY_DSN=

# Server-side image resizing. Requires a Supabase plan that includes image
# transformations — turning this on without one makes every photo 404.
# Set to true after upgrading; it is the single biggest egress saving.
SUPABASE_IMAGE_TRANSFORMS=false

# Optional public-media rollout. Leave disabled until the Cloudflare Worker
# and R2 public hostname have been configured and smoke-tested.
R2_PUBLIC_MEDIA_ENABLED=false
R2_SIGNER_URL=
R2_PUBLIC_BASE_URL=
# Comma-separated categories explicitly approved for public R2 storage.
# Keep this empty until each bucket's privacy model has been reviewed.
R2_PUBLIC_MEDIA_CATEGORIES=
