# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Env — never commit secrets
.env
.env.local
*.env.local

# Android signing — never commit keystore or passwords
**/key.properties
*.jks
*.keystore

# Generated Dart code (committed only at release time)
*.g.dart
*.freezed.dart
**/*.config.dart

# pubspec lock kept; uncomment if you prefer not to commit
# pubspec.lock

# Stitch design tool refs
.stitch-refs/

# Design probes + throwaway preview entrypoints (dev-only)
.probes/

# Agent-session scratch: browser snapshots and iteration screenshots produced
# while verifying changes. Useful in the moment, not useful in history — they
# bloat the repo (100s of PNGs/YAMLs) and nobody reads an old one later.
.playwright-mcp/
/artifacts/
/*.png

# Node build artifacts under infra/ (e.g. infra/media-signer)
**/node_modules/
**/.wrangler/
lib/preview_*.dart

# opencode config (may contain API keys)
opencode.json

# Cloudflare Worker local state and secrets
infra/media-signer/node_modules/
infra/media-signer/.wrangler/
infra/media-signer/.dev.vars


# Local tooling output (design critiques) — not part of the project.
.impeccable/

# One-off repair scripts and their scratch output (2026-07-28 branch repair).
# Kept out of the tree: they encode a snapshot of broken state, not a tool.
/*.py
/scratch/
/arabic_strings.txt
/found_trust.txt
/trust_signals_lines.txt
/supabase_login.txt
