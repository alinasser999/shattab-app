# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Env — never commit secrets
.env
.env.local
*.env.local

# Android signing — never commit keystore or passwords
**/key.properties
*.jks
*.keystore

# Generated Dart code (committed only at release time)
*.g.dart
*.freezed.dart
**/*.config.dart

# pubspec lock kept; uncomment if you prefer not to commit
# pubspec.lock

# Stitch design tool refs
.stitch-refs/

# opencode config (may contain API keys)
opencode.json

