{
  "rules": [
    {
      "allowed": {
        "origins": ["https://app.example.com", "http://localhost:6434"],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["Content-Type", "Content-Length", "Cache-Control"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
