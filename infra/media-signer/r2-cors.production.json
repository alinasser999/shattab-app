{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://shattab.vercel.app",
          "https://shattab.app",
          "https://www.shattab.app",
          "http://localhost:6434"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["Content-Type", "Content-Length", "Cache-Control"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
