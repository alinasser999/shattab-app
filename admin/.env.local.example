# Same Supabase project as the Flutter app. These are the ANON key values — the
# console deliberately has no service-role key. Every privilege comes from
# is_admin() inside Postgres, so a leaked build of this app grants nothing on
# its own. Copy to .env.local and paste the values from the app's .env.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
